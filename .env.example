# Copy to .env and fill in. Never commit .env.

# Altana owner (admin) key: grants and revokes session keys. Must be fresh
# (nonce 0) before the first `setup`; fund it, never send from it.
OWNER_PRIVATE_KEY=
# The agent's session key (secp256k1). `setup` grants it on the owner's wallet.
AGENT_SESSION_KEY=
# Seller payout address: receives settlements, checked in /tab/settle-record.
SELLER_ADDRESS=

# Optional
RPC_URL=https://forno.celo.org
ATTRIB_CODE=tab
PORT=8791
SELLER_URL=http://127.0.0.1:8791
# Public seller URL published in the ERC-8004 record by `register`.
PUBLIC_SELLER_URL=
# Self Agent ID proof-of-human gate (off by default).
REQUIRE_SELF=false
AGENT_PRIVATE_KEY=
