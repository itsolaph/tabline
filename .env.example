# Copy to .env and fill in. Never commit .env.
# Self agent key (from `self-agent register export --unsafe --print-private-key`)
AGENT_PRIVATE_KEY=
# Altana admin (owner) key — the human's authority. Grant/revoke only.
OWNER_PRIVATE_KEY=
# Seller payout wallet (receives tab settlements). Generate a fresh burner.
SELLER_PRIVATE_KEY=
# Optional: x402 facilitator API key (x402_...), enables instant x402 routes
X402_API_KEY=
# Celo RPC (defaults to https://forno.celo.org)
RPC_URL=
# Attribution code embedded in tx calldata suffix (ERC-8021)
ATTRIB_CODE=tab
# Server port
PORT=8787
